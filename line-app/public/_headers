# Cloudflare Workers static assets headers (static files bypass the Worker).
# Learner pages get no CSP here: it would have to allow the LIFF SDK and LINE hosts, which cannot be verified without a real LINE client.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# object-src blob: rather than 'none': a blob: PDF in the preview iframe inherits this CSP and Chrome's PDF viewer needs it.
# also covers /admin.html, /admin.css and /admin.js (listing /admin.html separately would send every header twice)
/admin*
  Content-Security-Policy: default-src 'self'; frame-ancestors 'none'; img-src 'self' blob: data:; media-src 'self' blob:; frame-src blob:; object-src blob:; base-uri 'none'; form-action 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com
  X-Frame-Options: DENY
