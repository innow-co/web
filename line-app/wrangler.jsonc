{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "innow-line",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "innow-line",
      "database_id": "8025266b-92c7-4e9a-af71-eed025bde34e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "innow-line-files" }
  ],
  "vars": {
    // PRODUCTION setup: provider "Innow", MINI App channel "Innow Members" (2012547684, Unverified), OA "อาจารย์ไพบูลย์ Innow".
    // Public identifiers, not secrets. (Old test setup: Bot 2023 / "Innow Test" 2012557246-8, @276eafaf.)
    // LIFF_ID is the Developing channel's LIFF ID.
    "LIFF_ID": "2012547684-HJKrsHm3",
    // Comma-separated allowlist: Developing, Review and Published channel IDs of the MINI App.
    "LINE_LOGIN_CHANNEL_ID": "2012547684,2012547685,2012547686",
    // Basic ID of the OA members are asked to add (production OA)
    "OA_BASIC_ID": "@355rjzvz",
    "FACEBOOK_URL": "https://www.facebook.com/innow.co.th",
    "REQUIRE_FRIEND": "true",
    // Quote requests are copied server-to-server to the website's contact endpoint (it emails ask@innow.co.th). Empty disables.
    "INQUIRY_FORWARD_URL": "https://innow.co.th/api/contact"
  },
  // Custom domain: Cloudflare creates the DNS record and certificate (the innow.co.th zone is on this account).
  // workers_dev must stay true: the LINE MINI App endpoint points at the workers.dev URL until it is switched to the custom domain.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "line.innow.co.th", "custom_domain": true }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): ADMIN_PASSWORD, SESSION_SECRET
}
