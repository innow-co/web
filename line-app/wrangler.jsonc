{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "innow-line",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "innow-line",
      "database_id": "8025266b-92c7-4e9a-af71-eed025bde34e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "innow-line-files" }
  ],
  "vars": {
    // TEST setup: Bot 2023 provider, MINI App channel "Innow Test" (Unverified). Public identifiers, not secrets.
    // Replace all three with the production Innow MINI App / OA values at go-live.
    // LIFF_ID is the Developing channel's LIFF ID.
    "LIFF_ID": "2012557246-GV0GKhsl",
    // Comma-separated allowlist: Developing, Review and Published channel IDs of the MINI App.
    "LINE_LOGIN_CHANNEL_ID": "2012557246,2012557247,2012557248",
    // Basic ID of the linked OA (Bot 2023)
    "OA_BASIC_ID": "@276eafaf",
    "FACEBOOK_URL": "https://www.facebook.com/innow.co.th",
    "REQUIRE_FRIEND": "true",
    // Quote requests are copied server-to-server to the website's contact endpoint (it emails ask@innow.co.th). Empty disables.
    "INQUIRY_FORWARD_URL": "https://innow.co.th/api/contact"
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): ADMIN_PASSWORD, SESSION_SECRET
}
